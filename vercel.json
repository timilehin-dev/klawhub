{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/inngest.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/events",  "dest": "/api/events.go"  },
    { "src": "/api/actions", "dest": "/api/actions.go" },
    { "src": "/api/commands","dest": "/api/commands.go"},
    { "src": "/api/oauth",   "dest": "/api/oauth.go"   },
    { "src": "/api/health",  "dest": "/api/health.go"  },
    { "src": "/api/inngest", "dest": "/api/inngest.py" },
    { "src": "/(.*)",        "dest": "/$1"              }
  ]
}

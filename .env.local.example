# Database (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# Slack
SLACK_BOT_TOKEN="xoxb-..."
SLACK_SIGNING_SECRET="..."
SLACK_APP_TOKEN="xapp-..."

# LLM (Ollama Cloud)
OLLAMA_API_KEY_1="..."
OLLAMA_API_KEY_2="..."
OLLAMA_MODEL="gemma4:31b-cloud"
OLLAMA_BASE_URL="https://api.ollama.com/v1"

# Search (Tavily)
TAVILY_API_KEY_1="..."
TAVILY_API_KEY_2="..."

# Sandbox (Modal)
MODAL_TOKEN_ID="..."
MODAL_TOKEN_SECRET="..."
MODAL_APP_NAME="klawhub-sandbox"
MODAL_FUNCTION_URL="https://[YOUR_MODAL_USERNAME]--klawhub-sandbox-dev.modal.run"
MODAL_WEBHOOK_SECRET=""  # Shared secret for sandbox auth (generate a strong random string)

# Inngest
INNGEST_SIGNING_KEY="..."
INNGEST_EVENT_KEY="..."

# LLM Router (future multi-provider)
# LLM_PROVIDER="ollama"  # ollama | openai | anthropic | google (future)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_AI_API_KEY=""

# Usage Tracking
# CREDIT_COST_PER_1K_TOKENS="0.1"  # default cost multiplier

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SLACK_CLIENT_ID=""  # Slack App Client ID (from api.slack.com/apps → Basic Information → App Credentials)
NODE_ENV="development"

# Log Level

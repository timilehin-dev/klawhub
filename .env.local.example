# Database (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# Slack
SLACK_BOT_TOKEN="xoxb-..."
SLACK_SIGNING_SECRET="..."
SLACK_APP_TOKEN="xapp-..."

# LLM (Ollama Cloud — default provider for all agents)
OLLAMA_API_KEY_1="..."
OLLAMA_API_KEY_2="..."
OLLAMA_API_KEY_3="..."
OLLAMA_MODEL="gemma4:31b-cloud"
OLLAMA_ENGINEER_MODEL="kimi-k2.6:cloud"
OLLAMA_BASE_URL="https://api.ollama.com"

# Search (Tavily)
TAVILY_API_KEY_1="..."
TAVILY_API_KEY_2="..."

# Sandbox (Modal)
MODAL_TOKEN_ID="..."
MODAL_TOKEN_SECRET="..."
MODAL_APP_NAME="klawhub-sandbox"
MODAL_FUNCTION_URL="https://[YOUR_MODAL_USERNAME]--klawhub-sandbox-dev.modal.run"
MODAL_WEBHOOK_SECRET=""  # Shared secret for sandbox auth (generate a strong random string)

# Inngest
INNGEST_SIGNING_KEY="..."
INNGEST_EVENT_KEY="..."

# LLM Router (providers are auto-detected from env vars above)
# Agent-to-provider mapping is in src/lib/llm/providers.ts

# Usage Tracking
# CREDIT_COST_PER_1K_TOKENS="0.1"  # default cost multiplier

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SLACK_CLIENT_ID=""  # Slack App Client ID
SLACK_CLIENT_SECRET=""           # Slack App Client Secret (server-side only)
NEXT_PUBLIC_SITE_URL="https://klawhub.com"
NODE_ENV="development"

# Integration Encryption (generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTEGRATION_ENCRYPTION_KEY=""

# Google Workspace
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# (Google Workspace and GitHub are optional integrations — only configure the ones you use)

# Browser Automation (Lightpanda or any CDP-compatible browser)
# BROWSER_WS_URL="ws://localhost:9222"

# Log Level
# LOG_LEVEL="info"  # debug | info | warn | error

# ============================================================
# KlawHub v2 — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in all values.
# All production secrets are stored in Vercel Environment Variables.
# ============================================================

# ── LLM (Nemotron via Ollama-compatible endpoint) ──────────
OLLAMA_API_KEY=                    # Optional: API key if endpoint requires auth
OLLAMA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=                      # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # service_role key (never expose to browser)
SUPABASE_ANON_KEY=                 # anon/public key (safe for browser)
DATABASE_URL=                      # postgres://... via transaction pooler (port 6543)
DIRECT_DATABASE_URL=               # postgres://... direct connection (port 5432, migrations only)

# ── Upstash Redis ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=            # https://<instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=          # REST API token
UPSTASH_REDIS_URL=                 # rediss://... URI for SDK usage

# ── Slack App ───────────────────────────────────────────────
SLACK_BOT_TOKEN=                   # xoxb-... Bot OAuth Token
SLACK_SIGNING_SECRET=              # Found in Slack App → Basic Information
SLACK_APP_TOKEN=                   # xapp-... (optional, for Socket Mode)
SLACK_CLIENT_ID=                   # App credentials → Client ID
SLACK_CLIENT_SECRET=               # App credentials → Client Secret

# ── Inngest ─────────────────────────────────────────────────
INNGEST_EVENT_KEY=                 # Found in Inngest dashboard → Event Keys
INNGEST_SIGNING_KEY=               # Found in Inngest dashboard → Signing Keys
INNGEST_BASE_URL=                  # Optional: override for self-hosted Inngest

# ── Modal ───────────────────────────────────────────────────
MODAL_TOKEN_ID=                    # modal token new → Token ID
MODAL_TOKEN_SECRET=                # modal token new → Token Secret
# IMPORTANT: Also create a Modal Secret named "klawhub-secrets" containing:
#   SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
#   Run: modal secret create klawhub-secrets SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=...

# ── Tavily (Web Search) ─────────────────────────────────────
TAVILY_API_KEY=                    # https://tavily.com → API Keys

# ── Google OAuth (Calendar, Drive) ─────────────────────────
GOOGLE_CLIENT_ID=                  # GCP Console → Credentials → OAuth 2.0
GOOGLE_CLIENT_SECRET=              # GCP Console → Credentials → OAuth 2.0

# ── GitHub App ──────────────────────────────────────────────
GITHUB_APP_ID=                     # GitHub → Developer Settings → GitHub Apps
GITHUB_APP_PRIVATE_KEY=            # PEM key (base64 encoded)
GITHUB_APP_CLIENT_ID=              # GitHub App → Client ID
GITHUB_APP_CLIENT_SECRET=         # GitHub App → Client Secret

# ── Security ────────────────────────────────────────────────
ENCRYPTION_KEY=                    # AES-256-GCM key: run `openssl rand -hex 32`
HMAC_SECRET=                       # HMAC signing secret for agent state integrity

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=               # https://klawhub.vercel.app (no trailing slash)
ENVIRONMENT=production             # 'production' or 'development'
LOG_LEVEL=info                     # 'debug', 'info', 'warning', 'error'
